<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkListStore" id="store_shortcut_keybind">
    <columns>
      <!-- column-name binding_mods -->
      <column type="gint"/>
      <!-- column-name binding_key -->
      <column type="gint"/>
    </columns>
    <data>
      <row>
        <col id="0">0</col>
        <col id="1">0</col>
      </row>
    </data>
  </object>

  <object class="AdwPreferencesPage" id="sensitivity">
    <property name="name">sensitivity</property>
    <property name="title" translatable="yes">Sensitivity</property>
    <property name="icon-name">org.gnome.Settings-accessibility-pointing-symbolic</property>

    <child>
      <object class="AdwPreferencesGroup" id="sensitivity_group">
        <property name="title" translatable="yes">Sensitivity</property>

        <child>
          <object class="AdwSwitchRow" id="row_mouse_sensitive">
            <property name="title" translatable="yes">Show panel when mouse approaches edge of the screen</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="row_mouse_sensitive_fullscreen_window">
            <property name="title" translatable="yes">In the above case, also show panel when fullscreen</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="row_show_in_overview">
            <property name="title" translatable="yes">Show panel in overview</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="row_hot_corner">
            <property name="title" translatable="yes">Keep hot corner sensitive, even in hidden state</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="row_mouse_triggers_overview">
            <property name="title" translatable="yes">In the above case show overview, too</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="row_keep_round_corners">
            <property name="title" translatable="yes">Keep round corners when top bar is hidden</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow" id="row_pressure_threshold">
            <property name="title" translatable="yes">Pressure barrier's threshold:</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="upper">10000</property>
                <property name="step-increment">1</property>
                <property name="page-increment">10</property>
              </object>
            </property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow" id="row_pressure_timeout">
            <property name="title" translatable="yes">Pressure barrier's timeout:</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="upper">10000</property>
                <property name="step-increment">1</property>
                <property name="page-increment">10</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="animation">
    <property name="name">animation</property>
    <property name="title" translatable="yes">Animation</property>
    <property name="icon-name">video-x-generic-symbolic</property>

    <child>
      <object class="AdwPreferencesGroup" id="animation_group">
        <property name="title" translatable="yes">Animation</property>

        <child>
          <object class="AdwSpinRow" id="row_animation_time_overview">
            <property name="title" translatable="yes">Slide animation time when entering/leaving overview:</property>
            <property name="digits">2</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="upper">1.0</property>
                <property name="step-increment">0.10</property>
                <property name="page-increment">0.10</property>
              </object>
            </property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow" id="row_animation_time_autohide">
            <property name="title" translatable="yes">Slide animation time when mouse approaches edge of the screen:</property>
            <property name="digits">2</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="upper">1.0</property>
                <property name="step-increment">0.10</property>
                <property name="page-increment">0.10</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="shortcuts">
    <property name="name">shortcuts</property>
    <property name="title" translatable="yes">Keyboard shortcuts</property>
    <property name="icon-name">preferences-desktop-keyboard-shortcuts-symbolic</property>

    <child>
      <object class="AdwPreferencesGroup" id="shortcuts_group">
        <property name="title" translatable="yes">Keyboard shortcuts</property>

        <child>
          <object class="AdwActionRow" id="row_shortcut_keybind">
            <property name="title" translatable="yes">Key that triggers the bar to be shown (press backspace to deactivate the shortcut):</property>
            <property name="activatable-widget">accel_shortcut_keybind</property>
            <child>
              <object class="GtkTreeView">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="model">store_shortcut_keybind</property>
                <property name="headers-visible">False</property>
                <property name="enable-search">False</property>
                <property name="show-expanders">False</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
                <child internal-child="selection">
                  <object class="GtkTreeSelection"/>
                </child>
                <child>
                  <object class="GtkTreeViewColumn">
                    <property name="min-width">200</property>
                    <property name="title" translatable="no">column</property>
                    <property name="sort-column-id">0</property>
                    <child>
                      <object class="GtkCellRendererAccel" id="accel_shortcut_keybind">
                        <property name="editable">True</property>
                      </object>
                      <attributes>
                        <attribute name="accel-key">1</attribute>
                        <attribute name="accel-mods">0</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow" id="row_shortcut_delay">
            <property name="title" translatable="yes">Delay before the bar rehides after key press (a value of 0 disables the rehiding):</property>
            <property name="digits">2</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="upper">10</property>
                <property name="step-increment">0.10</property>
                <property name="page-increment">1.0</property>
              </object>
            </property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="row_shortcut_toggles">
            <property name="title" translatable="yes">Pressing the shortcut again rehides the panel</property>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="intellihide">
    <property name="name">intellihide</property>
    <property name="title" translatable="yes">Intellihide</property>
    <property name="icon-name">focus-windows-symbolic</property>

    <child>
      <object class="AdwPreferencesGroup" id="intellihide_group">
        <property name="title" translatable="yes">Intellihide</property>

        <child>
          <object class="AdwSwitchRow" id="row_enable_intellihide">
            <property name="title" translatable="yes">Only hide panel when a window takes the space</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="row_enable_active_window">
            <property name="title" translatable="yes">Only when the active window takes the space</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
